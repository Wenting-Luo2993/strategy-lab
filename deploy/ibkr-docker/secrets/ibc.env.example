# Copy to secrets/ibc.env on the deployment host and fill there.
# Do not commit the copied file.

DISPLAY=:1
TWS_MAJOR_VRSN=1045
IBC_INI=/etc/ibkr/config.ini
TRADING_MODE=paper
TWOFA_TIMEOUT_ACTION=exit
IBC_PATH=/opt/IBC
TWS_PATH=/opt/ibkr
TWS_SETTINGS_PATH=/opt/ibkr/ibgateway
LOG_PATH=/var/log/ibkr
APP=GATEWAY
ENABLE_VNC=false

# Prefer credentials in secrets/config.ini, matching the current VM model.
# Leave these blank unless deliberately using env-based IBC credentials.
TWSUSERID=
TWSPASSWORD=
FIXUSERID=
FIXPASSWORD=
