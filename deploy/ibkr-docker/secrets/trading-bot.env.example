# Copy to secrets/trading-bot.env on the deployment host and fill there.
# Do not commit the copied file.

BROKER__IB_ACCOUNT_ID=DUQ886014
BROKER__IB_ACCOUNT_BASE_CURRENCY=CAD
BROKER__IB_MODEL_CODE=
BROKER__IB_ACCOUNT_DATA_TIMEOUT_SECONDS=5
BROKER__IB_EXECUTION_DB_PATH=/app/data/local/ib_executions.db
DISCORD_WEBHOOK_URL=
NOTIFICATIONS__NOTIFY_ROUTINE=false
NOTIFICATIONS__NOTIFY_ON_ERROR=true

DASHBOARD__ACCOUNT_ID=DUQ886014
DASHBOARD__SUPABASE_URL=https://example.supabase.co
DASHBOARD__SUPABASE_ANON_KEY=
DASHBOARD__SUPABASE_SERVICE_KEY=

OPERATIONAL_METRICS__REMOTE_ENABLED=true
OPERATIONAL_METRICS__SUPABASE_URL=https://example.supabase.co
OPERATIONAL_METRICS__SUPABASE_ANON_KEY=
OPERATIONAL_METRICS__SUPABASE_TABLE=operational_metrics
