# Copy to secrets/trading-bot.env on the deployment host and fill there.
# Do not commit the copied file. Non-secret broker/runtime settings live in
# docker-compose.paper.yml; values there override this file.
# Relative paths resolve under /app in the container (./data -> /app/data).

BROKER__IB_ACCOUNT_BASE_CURRENCY=CAD
BROKER__IB_MODEL_CODE=
BROKER__IB_ACCOUNT_DATA_TIMEOUT_SECONDS=5
NOTIFICATIONS__DISCORD_WEBHOOK_URL=
NOTIFICATIONS__NOTIFY_ROUTINE=false
NOTIFICATIONS__NOTIFY_ON_ERROR=true

DASHBOARD__ENABLED=true
DASHBOARD__REMOTE_PROVIDER=supabase
DASHBOARD__ACCOUNT_ID=DUQ886014
DASHBOARD__SYMBOLS=["QQQ"]
DASHBOARD__PRICE_TIMEFRAMES=["5m"]
DASHBOARD__SUPABASE_URL=https://example.supabase.co
# Bot-only server-side write key for the dashboard read model. The browser
# dashboard uses the anon key in its own config, not this file.
DASHBOARD__SUPABASE_SERVICE_KEY=

# Research publishing (RESEARCH_SUPABASE_*) runs from the research workstation's
# .env and is intentionally NOT deployed with the bot.

OPERATIONAL_METRICS__REMOTE_ENABLED=true
OPERATIONAL_METRICS__SUPABASE_URL=https://example.supabase.co
OPERATIONAL_METRICS__SUPABASE_ANON_KEY=
OPERATIONAL_METRICS__SUPABASE_TABLE=operational_metrics
